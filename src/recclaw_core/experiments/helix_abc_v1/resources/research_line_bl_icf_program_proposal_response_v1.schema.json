{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposals"
  ],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_role",
          "mechanism_program",
          "implementation_research",
          "resolution_facts"
        ],
        "properties": {
          "producer_role": {
            "type": "string"
          },
          "mechanism_program": {
            "type": "object"
          },
          "implementation_research": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_model_config",
              "mechanism_config_json"
            ],
            "properties": {
              "base_model_config": {
                "type": "string",
                "enum": [
                  "BPR",
                  "LightGCN"
                ]
              },
              "mechanism_config_json": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "resolution_facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested_current_semantics_digest",
              "capability_diff",
              "high_change_dimensions",
              "required_dependencies",
              "required_budget"
            ],
            "properties": {
              "requested_current_semantics_digest": {
                "type": "null"
              },
              "capability_diff": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "high_change_dimensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "COMPOSITE_MECHANISM",
                    "CORE_OBJECTIVE",
                    "CORE_RELATION",
                    "CORE_REPRESENTATION",
                    "CUSTOM_EXECUTABLE_CAPABILITY",
                    "INTERACTION_STRUCTURE",
                    "MODEL_STRUCTURE",
                    "PROPAGATION_MECHANISM",
                    "TRAINING_PROCEDURE"
                  ]
                }
              },
              "required_dependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "numpy",
                    "python-stdlib",
                    "pytorch",
                    "recbole-runtime",
                    "scipy",
                    "torch"
                  ]
                }
              },
              "required_budget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "implementation_token_ceiling",
                  "qualification_gpu_minutes",
                  "qualification_wall_minutes"
                ],
                "properties": {
                  "implementation_token_ceiling": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "qualification_gpu_minutes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "qualification_wall_minutes": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
