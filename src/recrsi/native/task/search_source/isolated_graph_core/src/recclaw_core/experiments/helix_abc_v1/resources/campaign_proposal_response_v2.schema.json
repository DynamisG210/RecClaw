{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_label": {"type": "string", "minLength": 1, "maxLength": 160},
          "mechanism_id": {
            "type": "string",
            "pattern": "^(BPR_MF|LIGHTGCN)(__[A-Z0-9_]+){0,2}$"
          },
          "composition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "base_mechanism_id": {
                "type": "string",
                "enum": ["BPR_MF", "LIGHTGCN"]
              },
              "primary_operator_id": {
                "type": ["string", "null"]
              },
              "secondary_operator_id": {
                "type": ["string", "null"]
              }
            },
            "required": [
              "base_mechanism_id",
              "primary_operator_id",
              "secondary_operator_id"
            ]
          },
          "mechanism_hypothesis": {"type": "string", "minLength": 1, "maxLength": 800},
          "competing_hypothesis": {"type": "string", "minLength": 1, "maxLength": 800},
          "predicted_outcome_signature": {"type": "string", "minLength": 1, "maxLength": 500},
          "failure_mode": {"type": "string", "minLength": 1, "maxLength": 500},
          "original_priority": {
            "type": ["string", "null"],
            "enum": ["high", "medium", "low", null]
          },
          "parent_candidate_id": {
            "type": "null"
          },
          "proposal_intent": {
            "type": "string",
            "enum": ["DISCOVERY", "FALSIFICATION", "CONTROL"]
          },
          "utility_features": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "useful_signal": {"type": "number", "minimum": 0, "maximum": 1},
              "frontier_potential": {"type": "number", "minimum": 0, "maximum": 1},
              "information_gain": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["useful_signal", "frontier_potential", "information_gain"]
          }
        },
        "required": [
          "candidate_label",
          "mechanism_id",
          "composition",
          "mechanism_hypothesis",
          "competing_hypothesis",
          "predicted_outcome_signature",
          "failure_mode",
          "original_priority",
          "parent_candidate_id",
          "proposal_intent",
          "utility_features"
        ]
      }
    }
  },
  "required": ["proposals"]
}
