"q5a-valid-pilot-20260803-02-shared-realization-round-3-profile:6f8e5787a1d6c3001f848292ac7a113eb78b0558ad7c1bbf5f8d7bca2f32dd26","experiment_binding_digest":"9dc10e6dceeab4aa0d5e08a9b8c6b7e66819a5adac72a3d538c1fdb6ca96e9c1","experiment_binding_ref":"q5a-valid-pilot-20260803-02-shared-realization-round-3-binding:9dc10e6dceeab4aa0d5e08a9b8c6b7e66819a5adac72a3d538c1fdb6ca96e9c1","experiment_executed":true,"failure_class":"INCONCLUSIVE","hypothesis":"A candidate-local pairwise recommender that represents each user and item as adaptive mixtures over shared latent prototypes, then scores user-item pairs through disagreement-aware prototype routing with a residual anti-collapse objective, will improve full-sort NDCG@10 on ML-1M over a matched single-embedding collaborative filtering control because it can preserve and selectively activate minority but coherent user intents that static embeddings average away.","mechanism_interpretation":"NOT_ADJUDICATED","mechanism_negative_evidence":false,"next_discriminative_test":"If a matched single-embedding or single-channel scorer with comparable parameter count matches or exceeds the proposed model, or if collapsing adaptive mixtures to one embedding leaves performance unchanged, then the prototype-routing hypothesis is not supported.","outcome_digest":"6b98e55985097b4185a85c9d5980eb2ca90aa26a46089414880dc119c14a5e23","outcome_ref":"q5a-valid-pilot-20260803-02-shared-realization-round-3-outcome:6b98e55985097b4185a85c9d5980eb2ca90aa26a46089414880dc119c14a5e23","protocol_digest":"7f623fd953001f999e8b5d2657749f6a3ca86c7be5410a48bb8281241a258bbe","protocol_ref":"recclaw.campaign.ml1m-full-sort.v1","qualification_evidence_used_as_scientific":false,"qualification_receipt_digest":"cb83d0c500519b84ac47bcaea55d5af4e6ee8959607faccd115132ea65ce0353","qualification_receipt_ref":"recclaw-qualification-receipt-v1:cb83d0c500519b84ac47bcaea55d5af4e6ee8959607faccd115132ea65ce0353","schema":"recclaw.research-line.vnext.typed-research-episode.v1"}}
