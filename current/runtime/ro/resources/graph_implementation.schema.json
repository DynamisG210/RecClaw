{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph candidate.py implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposals"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "recclaw.research-line.fresh-r1-implementation-response.v1"
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entrypoint",
          "files",
          "implementation_summary"
        ],
        "properties": {
          "entrypoint": {
            "type": "string",
            "const": "candidate:FreshCandidateModel"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "enum": [
                    "candidate.py"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "implementation_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
